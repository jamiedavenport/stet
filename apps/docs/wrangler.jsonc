{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stet-docs",
  "compatibility_date": "2026-07-19",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
    },
  },
  "upload_source_maps": true,
  "main": "src/server.ts",
  "routes": [
    {
      "pattern": "docs.stetcms.com",
      "custom_domain": true,
    },
  ],
}
