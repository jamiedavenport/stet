---
import Layout from '@/layouts/Layout.astro';
import { stet } from '@/stet.gen';
import type { PostsEntry } from '@/stet.gen';

export const prerender = true;

export async function getStaticPaths() {
  if (process.env.STET_API_KEY === undefined || process.env.STET_API_KEY === '') {
    return [];
  }
  const posts = await stet.posts.list();
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { slug } = Astro.params;
if (slug === undefined) {
  throw new Error('Route without a slug parameter.');
}

const prerenderedPost = Astro.props.post as PostsEntry | undefined;
const post = prerenderedPost ?? (await stet.posts.get(slug));
---

<Layout title={`${post.title} · Stet example`}>
  <main>
    <p>
      <a href="/blog">← Blog</a>
    </p>
    <h1>{post.title}</h1>
    <p class="muted">Updated {new Date(post.updatedAt).toLocaleDateString('en-GB')}</p>
    {post.fields.cover && <img src={post.fields.cover.url} alt="" />}
    {
      post.fields.body == null ? (
        <p class="muted">This post has no body yet.</p>
      ) : (
        <div set:html={post.fields.body.html} />
      )
    }
  </main>
</Layout>
