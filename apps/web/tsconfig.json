{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "paths": {
      "#/*": ["./src/*"]
    },
    "types": ["vite/client"],
    "verbatimModuleSyntax": false,
    "plugins": [{ "name": "@tsrx/typescript-plugin" }]
  },
  "include": ["src", "src/**/*.tsrx", "worker-configuration.d.ts", "tsrx-core.d.ts"]
}
