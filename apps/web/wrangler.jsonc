{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stet-web",
  "compatibility_date": "2026-07-19",
  // global_fetch_strictly_public: without it, a fetch() to our own zone skips
  // Workers routing and dials the zone's origin server, which does not exist
  // on a Workers-only zone, so it fails as a 522. The analytics route forwards
  // to STET_ORIGIN, which is this same worker, and needs the request to reach
  // Cloudflare's front door and come back in.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": {
    "enabled": true,
    // OpenTelemetry spans for every fetch and binding call, so a slow request
    // can be read as a waterfall instead of inferred from log timestamps.
    "traces": {
      "enabled": true,
    },
  },
  // Readable stack traces in Workers Logs and Sentry. Wrangler uploads the
  // maps to Cloudflare; they are never served to the browser.
  "upload_source_maps": true,
  "main": "src/server.ts",
  "routes": [
    {
      "pattern": "stetcms.com",
      "custom_domain": true,
    },
    {
      // Serves nothing: src/canonical-host.ts redirects it to the apex. It
      // still needs a domain of its own, because a hostname with no route
      // never reaches the worker to be redirected.
      "pattern": "www.stetcms.com",
      "custom_domain": true,
    },
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://stetcms.com",
    // Must be a sender on a Resend-verified domain.
    "MAIL_FROM": "Stet <noreply@stetcms.com>",
    // How long notification emails wait in a user's outbox so a burst
    // collapses into one digest. Override in .dev.vars to test quickly.
    "NOTIFICATIONS_FLUSH_SECONDS": "300",
    // How long content changes collect before the organization's
    // content.changed webhook fires, so an editing session triggers one
    // rebuild rather than one per keystroke. Override in .dev.vars to test
    // quickly.
    "WEBHOOKS_BATCH_SECONDS": "60",
    // Stripe price id (per-seat, monthly) for the paid plan. Empty locally:
    // without STRIPE_SECRET_KEY billing runs against the built-in fake
    // Stripe, which supplies its own price id.
    "STRIPE_PRICE_PAID": "price_1TyHfDIdr8Yx5Wu4S72eWS2I",
    // The Stet that Stet's own product analytics go to, which is this same
    // deployment: events leave the Worker and come back in through the public
    // API, so the path customers take is the path we run on.
    "STET_ORIGIN": "https://stetcms.com",
    // The off switch for this deployment's own product analytics. Separate
    // from the STET_API_KEY secret because that key has a second job: a
    // developer generating the content client needs a real one, and their
    // traffic still has to stay out of this project. Only the literal "false"
    // turns recording off; blank leaves it to whether a key is configured, so
    // forgetting the var records rather than silently dropping. A var and not
    // a secret, so an entry here is how it binds. Local dev sets it in
    // .dev.vars. See dogfooding/analytics.
    "ANALYTICS_ENABLED": "",
    // Sentry error tracking. The DSN is public (it ships in the worker and
    // only accepts event submissions). Blank disables reporting entirely, so
    // the app runs with no Sentry account.
    "SENTRY_DSN": "https://89a61a5144b9a8be6cc482b6ae04d2fa@o4504352086884352.ingest.us.sentry.io/4511808956989440",
    // Turnstile bot protection on the auth forms. Blank disables it; local
    // dev overrides in .dev.vars with the always-pass test pair, production
    // overrides the secret half with `wrangler secret put` (which shadows
    // the var) and sets the real site key here.
    "TURNSTILE_SITE_KEY": "",
    "TURNSTILE_SECRET_KEY": "",
  },
  // Wrangler refuses to deploy while a listed secret is unset, so only
  // genuinely mandatory secrets belong here. The optional ones are typed in
  // src/env.d.ts instead. Never give a secret an empty-string entry in `vars`
  // above to make it bind locally: this file is the source of truth, so the
  // plain-text value replaces whatever `wrangler secret put` stored under that
  // name. TURNSTILE_SECRET_KEY still does this and is disabled in production
  // as a result; see issue #57.
  "secrets": {
    "required": [
      "ANTHROPIC_API_KEY",
      "BETTER_AUTH_SECRET",
      "RESEND_API_KEY",
      "STRIPE_SECRET_KEY",
      "STRIPE_WEBHOOK_SECRET",
    ],
  },
  // Cron triggers and workflows are generated from the @repo/crons and
  // @repo/workflows registries in the root vite.config.ts.
  // Per-colo token buckets (no storage, no cost). AUTH_RATE_LIMIT throttles
  // the credential endpoints per IP+path; API_RATE_LIMIT throttles non-content
  // /api/v1 requests per API key. Content delivery is temporarily exempt.
  // Limits are generous enough for the e2e suite from one IP.
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 30,
        "period": 60,
      },
    },
    {
      "name": "API_RATE_LIMIT",
      "namespace_id": "1002",
      "simple": {
        "limit": 120,
        "period": 60,
      },
    },
    // Analytics ingest is a different shape of traffic: one request per
    // browser batch, so a busy site sends orders of magnitude more of them
    // than it makes content reads. This is a backstop against a runaway
    // client, not a product limit.
    {
      "name": "INGEST_RATE_LIMIT",
      "namespace_id": "1003",
      "simple": {
        "limit": 1000,
        "period": 10,
      },
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "JOBS",
        "queue": "stet-jobs",
      },
    ],
    "consumers": [
      {
        "queue": "stet-jobs",
        "max_retries": 5,
        "dead_letter_queue": "stet-jobs-dlq",
      },
    ],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stet-db",
      "database_id": "769a63d7-c262-4812-a477-adb661d2c05f",
      "migrations_dir": "../../internal/db/migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "stet-storage",
    },
  ],
  // Resizes and re-encodes uploaded images on the way out of /api/files.
  "images": {
    "binding": "IMAGES",
  },
  "durable_objects": {
    "bindings": [
      {
        // One per organization, holding its product analytics.
        "name": "ANALYTICS",
        "class_name": "AnalyticsStore",
      },
      {
        "name": "PAGE_PRESENCE",
        "class_name": "PagePresenceRoom",
      },
      {
        "name": "CHAT_AGENT",
        "class_name": "ChatAgent",
      },
      {
        // One per organization, batching its content changes into a single
        // webhook per window.
        "name": "CONTENT_CHANGES",
        "class_name": "ContentChangeBatch",
      },
      {
        "name": "NOTIFICATION_HUB",
        "class_name": "NotificationHub",
      },
    ],
  },
  "exports": {
    "AnalyticsStore": {
      "type": "durable-object",
      "storage": "sqlite",
    },
    "PagePresenceRoom": {
      "type": "durable-object",
      "storage": "sqlite",
    },
    "ChatAgent": {
      "type": "durable-object",
      "storage": "sqlite",
    },
    "ContentChangeBatch": {
      "type": "durable-object",
      "storage": "sqlite",
    },
    "NotificationHub": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
}
