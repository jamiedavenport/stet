---
import Layout from '@/layouts/Layout.astro';
import { stet } from '@/stet.gen';

export const prerender = true;

// Frontmatter runs on the server, so the organization API key (STET_API_KEY)
// never reaches the browser.
const hasStetApiKey = process.env.STET_API_KEY !== undefined && process.env.STET_API_KEY !== '';
const landing = hasStetApiKey ? await stet.landing.get() : undefined;
---

<Layout title="Stet example">
  <main>
    <h1>{landing?.fields.headline ?? landing?.title ?? 'Stet example'}</h1>
    {landing?.fields.pitch == null ? null : <div set:html={landing.fields.pitch.html} />}
    <p>
      <a href="/blog">Read the blog →</a>
    </p>
    <p class="muted">
      This page renders the “Landing” map; the blog renders the “Posts” collection. Both are typed
      from the model built in the Stet UI.
    </p>
  </main>
</Layout>
