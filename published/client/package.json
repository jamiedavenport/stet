{
  "name": "@stetcms/client",
  "version": "0.0.0",
  "description": "Typed client for the Stet API, generated from the oRPC contract.",
  "keywords": [
    "api",
    "client",
    "orpc",
    "stet"
  ],
  "homepage": "https://github.com/jamiedavenport/stet/tree/main/published/client#readme",
  "bugs": "https://github.com/jamiedavenport/stet/issues",
  "license": "Apache-2.0",
  "author": "Jamie Davenport (https://jxd.dev)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jamiedavenport/stet.git",
    "directory": "published/client"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./codegen": "./src/codegen.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./codegen": {
        "types": "./dist/codegen.d.ts",
        "default": "./dist/codegen.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "tc": "tsc --noEmit",
    "test": "vp test run"
  },
  "dependencies": {
    "@orpc/client": "catalog:",
    "@orpc/contract": "catalog:",
    "@orpc/openapi-client": "catalog:",
    "@stetcms/config": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@repo/api": "workspace:*",
    "publint": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}
