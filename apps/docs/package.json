{
  "name": "@repo/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "blume build --strict",
    "deploy": "pnpm build && wrangler deploy",
    "dev": "blume dev --port 3100",
    "postinstall": "node scripts/brand-assets.ts",
    "prebuild": "node scripts/brand-assets.ts",
    "predev": "node scripts/brand-assets.ts",
    "preview": "blume preview",
    "validate": "blume validate --strict",
    "size": "size-limit",
    "tc": "blume check"
  },
  "dependencies": {
    "@repo/api": "workspace:*",
    "@repo/brand": "workspace:*",
    "blume": "^1.2.1"
  },
  "devDependencies": {
    "@size-limit/file": "catalog:",
    "size-limit": "catalog:",
    "typescript": "catalog:",
    "wrangler": "catalog:"
  },
  "size-limit": [
    {
      "name": "all client chunks (gzip)",
      "path": "dist/_astro/**/*.js",
      "gzip": true,
      "limit": "1.2 MB"
    }
  ]
}
