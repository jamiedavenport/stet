{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": ["vite-plus", "vitest", "publint", "tailwindcss", "cloudflare"],
  "workspaces": {
    ".": {
      "ignoreDependencies": ["vite"]
    },
    "apps/*": {},
    "examples/*": {
      "ignore": ["src/**/stet.gen.ts"]
    },
    "examples/astro": {
      // `@stetcms/vite` loads it by path; no module imports it.
      "entry": ["stet.config.ts"],
      "ignore": ["src/stet.gen.ts"]
    },
    "examples/nextjs": {
      // `stet generate` loads it; no module imports it.
      "entry": ["stet.config.ts"],
      "ignore": ["src/stet.gen.ts"]
    },
    "examples/nuxt": {
      // vue is Nuxt's own peer and vue-tsc is what `nuxt typecheck` runs;
      // neither is imported anywhere knip can see.
      "ignoreDependencies": ["vue", "vue-tsc"]
    },
    "examples/sveltekit": {
      // `@stetcms/vite` loads it by path; no module imports it.
      "entry": ["stet.config.ts"],
      "ignore": ["src/**/stet.gen.ts"]
    },
    "internal/*": {},
    "published/*": {},
    "apps/web": {
      "entry": ["src/routes/**/*.{ts,tsx,tsrx}", "e2e/**/*.setup.ts"]
    },
    "apps/docs": {
      "entry": ["blume.config.ts", "docs/**/meta.ts", "scripts/*.ts"],
      // Blume reads the spec by path, so nothing imports @repo/api. The
      // dependency is what orders the build behind the package that writes it.
      "ignoreDependencies": ["@repo/api"]
    },
    "internal/db": {
      "drizzle": false,
      "ignore": ["drizzle.config.ts"]
    },
    "internal/ui": {
      "includeEntryExports": true
    },
    "published/client": {
      "ignoreDependencies": ["zod"]
    }
  }
}
