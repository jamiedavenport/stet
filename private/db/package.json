{
  "name": "@repo/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./search": "./src/search/index.ts",
    "./seed-data": "./src/seed-data.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "generate": "drizzle-kit generate",
    "push": "drizzle-kit push && node scripts/push-fts.ts",
    "push:remote": "DRIZZLE_REMOTE=1 drizzle-kit push && DRIZZLE_REMOTE=1 node scripts/push-fts.ts",
    "push:fts": "node scripts/push-fts.ts",
    "push:force": "drizzle-kit push --force && node scripts/push-fts.ts",
    "tc": "tsc --noEmit",
    "test": "vp test run"
  },
  "dependencies": {
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@nerdfolio/drizzle-d1-helpers": "catalog:",
    "@types/better-sqlite3": "catalog:",
    "@types/node": "catalog:",
    "better-sqlite3": "catalog:",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}
