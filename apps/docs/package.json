{
  "name": "@repo/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "analyze": "ANALYZE=1 vp build",
    "build": "fumadocs-mdx && tsc --noEmit && vp build",
    "cf-typegen": "wrangler types",
    "deploy": "vp build && wrangler deploy",
    "dev": "vp dev",
    "postinstall": "fumadocs-mdx",
    "preview": "vp preview",
    "size": "size-limit",
    "tc": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/geist": "catalog:",
    "@repo/api": "workspace:*",
    "@repo/brand": "workspace:*",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-start": "catalog:",
    "fumadocs-core": "catalog:",
    "fumadocs-mdx": "catalog:",
    "fumadocs-openapi": "catalog:",
    "fumadocs-ui": "npm:@fumadocs/base-ui@^16.12.0",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "shiki": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:",
    "@size-limit/file": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/mdx": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "size-limit": "catalog:",
    "sonda": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.2",
    "vite-plus": "catalog:",
    "wrangler": "catalog:"
  },
  "size-limit": [
    {
      "name": "client JS (gzip)",
      "path": "dist/client/**/*.js",
      "gzip": true,
      "limit": "800 kB"
    },
    {
      "name": "server worker JS (gzip)",
      "path": "dist/server/**/*.js",
      "gzip": true,
      "limit": "1.4 MB"
    }
  ]
}
