---
import Layout from '../../layouts/Layout.astro';
import { stet } from '../../stet.gen';

const { slug } = Astro.params;
if (slug === undefined) {
  throw new Error('Route without a slug parameter.');
}

const post = await stet.posts.get(slug);
---

<Layout title={`${post.title} · Stet example`}>
  <main data-slug={post.slug}>
    <p>
      <a href="/blog">← Blog</a>
    </p>
    <h1>{post.title}</h1>
    <p class="muted">Updated {new Date(post.updatedAt).toLocaleDateString('en-GB')}</p>
    {post.fields.cover && <img src={post.fields.cover.url} />}
    {
      post.fields.body == null ? (
        <p class="muted">This post has no body yet.</p>
      ) : (
        <div set:html={post.fields.body.html} />
      )
    }
  </main>
</Layout>

<!-- The pageview is automatic; this is the custom event on top of it. The
     slug crosses to the browser as a data attribute because this script is
     bundled once for every post rather than inlined per page. `slug` is
     checked against the plan, so renaming the prop fails the type check
     rather than quietly producing a column of nulls in the dashboard. -->
<script>
  import { analytics } from '../../analytics';

  const slug = document.querySelector<HTMLElement>('main[data-slug]')?.dataset.slug;
  if (slug !== undefined) {
    analytics.track('post.read', { slug });
  }
</script>
