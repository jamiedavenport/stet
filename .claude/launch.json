{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "vp",
      "runtimeArgs": ["dev", "apps/web"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "docs",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "docs", "dev"],
      "port": 3100
    },
    {
      "name": "astro-example",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@examples/astro", "dev"],
      "port": 3004
    },
    {
      "name": "sveltekit-example",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@examples/sveltekit", "dev"],
      "port": 3003
    }
  ]
}
