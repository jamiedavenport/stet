# Credentials for `pnpm push:remote` (production D1 via the HTTP API).
# Copy to .env (gitignored) and fill in the token.
#
# Account ID: dashboard sidebar or `wrangler whoami`.
# Token: https://dash.cloudflare.com/profile/api-tokens with Account > D1 > Edit.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_TOKEN=
